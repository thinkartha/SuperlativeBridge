{
  "endplex": {
    "schema": "https://endplex.com/schemas/collection/v1.json",
    "version": 1
  },
  "info": {
    "name": "SuperlativeBridge API",
    "description": "One-click requests for every SuperlativeBridge endpoint. Import into EndPlex (endplex.com), pick an environment, run 'Auth / POST /api/auth/signin' first to capture {{token}} and {{userId}}, then run any folder."
  },
  "auth": {
    "type": "bearer",
    "token": "{{token}}"
  },
  "variables": [
    {
      "name": "baseUrl",
      "value": "http://localhost:8081",
      "description": "Local Go API (docker compose). Use the API Gateway stage URL for deployed environments."
    },
    {
      "name": "demoEmail",
      "value": "maria@example.com",
      "description": "Demo GIG worker"
    },
    {
      "name": "demoPassword",
      "value": "password123",
      "description": "Password for every seeded demo account"
    },
    {
      "name": "token",
      "value": "",
      "description": "Filled automatically by the signin request"
    },
    {
      "name": "userId",
      "value": "",
      "description": "Filled automatically by the signin request"
    },
    {
      "name": "resourceId",
      "value": "1",
      "description": "Generic {id} path parameter"
    },
    {
      "name": "courseId",
      "value": "1"
    },
    {
      "name": "categoryId",
      "value": "1"
    },
    {
      "name": "mentorId",
      "value": "1"
    }
  ],
  "environments": [
    {
      "name": "Local (docker compose)",
      "variables": {
        "baseUrl": "http://localhost:8081"
      }
    },
    {
      "name": "Local (vite proxy)",
      "variables": {
        "baseUrl": "http://localhost:8080"
      }
    },
    {
      "name": "Deployed (API Gateway)",
      "variables": {
        "baseUrl": "https://REPLACE.execute-api.us-east-1.amazonaws.com/prod"
      }
    }
  ],
  "demoAccounts": [
    {
      "role": "admin",
      "email": "admin@example.com",
      "password": "password123"
    },
    {
      "role": "student (GIG worker)",
      "email": "maria@example.com",
      "password": "password123"
    },
    {
      "role": "employer",
      "email": "aisha@example.com",
      "password": "password123"
    },
    {
      "role": "mentor",
      "email": "sarah.mentor@example.com",
      "password": "password123"
    }
  ],
  "folders": [
    {
      "name": "Platform",
      "requests": [
        {
          "name": "GET /api/health",
          "protocol": "rest",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "headers": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "tests": [
            {
              "assert": "status",
              "operator": "equals",
              "value": 200
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "requests": [
        {
          "name": "POST /api/auth/signin",
          "protocol": "rest",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/signin",
            "headers": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "language": "json",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "postRequest": {
            "setVariables": [
              {
                "name": "token",
                "from": "body",
                "path": "token"
              },
              {
                "name": "userId",
                "from": "body",
                "path": "user.id"
              }
            ]
          },
          "tests": [
            {
              "assert": "status",
              "operator": "lessThan",
              "value": 400
            }
          ]
        },
        {
          "name": "POST /api/auth/signup",
          "protocol": "rest",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/signup",
            "headers": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "language": "json",
              "raw": "{\n  \"name\": \"New Worker\",\n  \"email\": \"new.worker@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}"
            }
          },
          "tests": [
            {
              "assert": "status",
              "operator": "lessThan",
              "value": 400
            }
          ]
        }
      ]
    },
