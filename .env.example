# ---------------------------------------------------------------------------
# SuperlativeBridge — local environment template
# Copy to .env (frontend, read by Vite) and/or export for the API container.
#   cp .env.example .env
# `docker compose up --build` already sets everything below for you; this file
# matters when you run pieces outside Docker.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, http://localhost:8080) --------------------------------
# Base URL of the API. Leave EMPTY to use same-origin relative paths ("/api/...")
# which the Vite dev proxy forwards to http://localhost:8081 (see vite.config.ts).
# Set explicitly for Docker/deployed use, e.g.
#   http://localhost:8081
#   https://xxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=

# --- Backend (Go API, http://localhost:8081) -------------------------------
# Postgres connection string used by every handler (pgx v5).
# Docker compose value: postgres://sbuser:sbpassword@db:5432/superlativebridge?sslmode=disable
DATABASE_URL=postgres://sbuser:sbpassword@localhost:5432/superlativebridge?sslmode=disable

# Secret used to sign and verify auth JWTs. Any non-empty string locally;
# use a long random value in production (SAM parameter JwtSecret).
JWT_SECRET=local-dev-jwt-secret-change-me

# Port the local HTTP server (backend/cmd/localserver) listens on.
PORT=8081

# --- Postgres container (docker-compose.yml) -------------------------------
POSTGRES_USER=sbuser
POSTGRES_PASSWORD=sbpassword
POSTGRES_DB=superlativebridge

# ---------------------------------------------------------------------------
# Demo logins (created by backend/migrations/002_seed.sql)
# Password for ALL demo accounts: password123
# The sign-in page has a one-click switcher for these.
#
#   admin@example.com             admin            -> /admin
#   maria@example.com             GIG worker       -> /student
#   aisha@example.com             employer         -> /employer/search
#   sarah.mentor@example.com      mentor           -> /student
# ---------------------------------------------------------------------------
DEMO_PASSWORD=password123
